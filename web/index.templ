package web

import "github.com/Jojojojodr/bonfirec2/web/components"

templ Layout(title string) {
    <!DOCTYPE html>
    <html lang="en">
    @head(title)
    <body class="min-h-screen bg-slate-950 text-slate-100 antialiased selection:bg-emerald-400/30 selection:text-emerald-50">
        <div class="relative isolate overflow-hidden">
            <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[34rem] bg-[radial-gradient(circle_at_top_left,_rgba(16,185,129,0.24),_transparent_40%),radial-gradient(circle_at_top_right,_rgba(59,130,246,0.2),_transparent_34%),linear-gradient(180deg,_rgba(15,23,42,0.96),_rgba(15,23,42,0.72)_35%,_rgba(15,23,42,0.96))]"></div>
            <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-24 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-emerald-400/10 blur-3xl"></div>
            @header()
            <main class="mx-auto flex min-h-[calc(100vh-5rem)] w-full max-w-7xl flex-col justify-start px-6 py-8 sm:px-8 lg:px-10">
                { children... }
            </main>
        </div>
        <div id="notification-toast-root" style="position: fixed; right: 1rem; bottom: 1rem; display: grid; gap: 0.6rem; z-index: 1200;"></div>
        <script>
            (() => {
                const STORAGE_KEY = "bonfire_notifications_last_seen"
                const toastRoot = document.getElementById("notification-toast-root")
                let lastSeenId = sessionStorage.getItem(STORAGE_KEY)

                const askPermission = () => {
                    if (!("Notification" in window)) {
                        return
                    }

                    if (Notification.permission === "default") {
                        Notification.requestPermission().catch(() => {})
                    }
                }

                const showToast = (notification) => {
                    if (!toastRoot) {
                        return
                    }

                    const levelColor = notification.level === "warning"
                        ? "rgba(251, 191, 36, 0.92)"
                        : notification.level === "success"
                            ? "rgba(52, 211, 153, 0.92)"
                            : "rgba(56, 189, 248, 0.92)"

                    const toast = document.createElement("div")
                    toast.style.cssText = "min-width: 260px; max-width: 340px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15); background: rgba(15,23,42,0.92); color: rgba(241,245,249,0.98); padding: 0.75rem 0.9rem; box-shadow: 0 10px 30px rgba(0,0,0,0.35); opacity: 0; transform: translateY(8px); transition: all 0.2s ease;"
                    toast.innerHTML = `<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.2rem;"><span style="display:inline-block; width:9px; height:9px; border-radius:999px; background:${levelColor};"></span><strong style="font-size:0.82rem;">${notification.title || "Notification"}</strong></div><div style="font-size:0.82rem; line-height:1.35;">${notification.message || ""}</div>`
                    toastRoot.prepend(toast)

                    requestAnimationFrame(() => {
                        toast.style.opacity = "1"
                        toast.style.transform = "translateY(0)"
                    })

                    setTimeout(() => {
                        toast.style.opacity = "0"
                        toast.style.transform = "translateY(6px)"
                        setTimeout(() => toast.remove(), 250)
                    }, 5500)
                }

                const showBrowserNotification = (notification) => {
                    if (!("Notification" in window)) {
                        return
                    }
                    if (Notification.permission !== "granted") {
                        return
                    }

                    const body = notification.message || ""
                    try {
                        new Notification(notification.title || "BonFireC2 Notification", { body })
                    } catch (_) {
                    }
                }

                const processNotifications = (items) => {
                    if (!Array.isArray(items) || items.length === 0) {
                        return
                    }

                    if (!lastSeenId) {
                        lastSeenId = items[0].id
                        sessionStorage.setItem(STORAGE_KEY, lastSeenId)
                        return
                    }

                    const lastSeenIndex = items.findIndex((item) => item.id === lastSeenId)
                    const unseen = lastSeenIndex >= 0 ? items.slice(0, lastSeenIndex).reverse() : items.slice().reverse()

                    unseen.forEach((notification) => {
                        showToast(notification)
                        showBrowserNotification(notification)
                    })

                    lastSeenId = items[0].id
                    sessionStorage.setItem(STORAGE_KEY, lastSeenId)
                }

                const pollNotifications = async () => {
                    try {
                        const response = await fetch("/api/notifications?limit=15", { headers: { "Accept": "application/json" } })
                        if (!response.ok) {
                            return
                        }

                        const payload = await response.json()
                        processNotifications(payload.notifications || [])
                    } catch (_) {
                    }
                }

                askPermission()
                pollNotifications()
                window.setInterval(pollNotifications, 4000)
            })()
        </script>
    </body>
    </html>
}

templ Index() {
    @Layout("Dashboard") {
        <section class="space-y-8">
            @components.DashboardHero()
            @components.DashboardStats()
            @components.DashboardContent()
        </section>
    }
}

templ NotFound() {
    @Layout("404 Not Found") {
        <section class="flex flex-col items-center justify-center gap-4">
            <h1 class="text-6xl font-bold text-slate-100">404</h1>
            <p class="text-lg text-slate-400">The page you are looking for does not exist.</p>
            <a href="/" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 transition hover:bg-white/10 hover:text-white">
                Go back to Dashboard
            </a>
        </section>
    }
}

templ head(title string) {
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/static/css/styles.css">
        <script src="https://unpkg.com/htmx.org@1.9.12"></script>
        <title>{title}</title>
    </head>
}

templ header() {
    <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/70 backdrop-blur-xl">
        <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4 sm:px-8 lg:px-10">
            <a href="/" class="group inline-flex items-center gap-3 text-sm font-semibold text-white">
                <span class="relative flex h-10 w-10 items-center justify-center rounded-2xl bg-white/5 ring-1 ring-inset ring-white/10 transition group-hover:bg-white/10">
                    <img src="/static/images/logoWhite.png" alt="BonFireC2 Logo" class="absolute h-6 w-6">
                    <img src="/static/images/logoDark.png" alt="BonFireC2 Logo" class="absolute h-6 w-6">
                </span>
                <span class="tracking-wide">BonFireC2</span>
            </a>
            <div class="flex items-center gap-3">
                <a href="/" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 transition hover:bg-white/10 hover:text-white">
                    Dashboard
                </a>
                <a href="/listeners" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 transition hover:bg-white/10 hover:text-white">
                    Listeners
                </a>
                <a href="/grunts" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 transition hover:bg-white/10 hover:text-white">
                    Grunts
                </a>
            </div>
        </nav>
    </header>
}